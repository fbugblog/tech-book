{
  "name": "tech-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "技術書の原稿リポジトリ（VitePress で Web 公開）",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "lint": "textlint \"docs/**/*.md\"",
    "lint:fix": "textlint --fix \"docs/**/*.md\"",
    "count": "node scripts/wordcount.mjs",
    "toc": "node scripts/build-toc.mjs",
    "new:topic": "node scripts/new.mjs topic",
    "new:page": "node scripts/new.mjs page"
  },
  "devDependencies": {
    "mermaid": "^11.17.2",
    "textlint": "^15.8.0",
    "textlint-filter-rule-allowlist": "^4.0.0",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "textlint-rule-prh": "^6.1.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  }
}
